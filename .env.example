# ── MCP Inspector — environment configuration ──────────────────────────────
# Copy this file to .env and fill in values for your environment.
# Never commit .env to version control.

# ── Security ───────────────────────────────────────────────────────────────
# REQUIRED in production: a long random string used to sign session cookies.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# ── Database ───────────────────────────────────────────────────────────────
# PostgreSQL (recommended for production):
#   DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/mcp_inspector
# SQLite (default — single-file, no extra setup):
#   DATABASE_URL=sqlite:///mcp_inspector.db
DATABASE_URL=sqlite:///mcp_inspector.db

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
# Leave empty to restrict to same-origin only.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com
CORS_ALLOWED_ORIGINS=

# ── Health checking ────────────────────────────────────────────────────────
# Seconds between automatic health sweeps of all registered servers.
HEALTH_CHECK_INTERVAL=60
# Maximum number of servers probed in parallel per sweep.
MAX_CONCURRENT_PROBES=10

# ── Request limits ─────────────────────────────────────────────────────────
# Maximum allowed request body size in megabytes.
MAX_CONTENT_LENGTH_MB=1

# ── Tool execution ─────────────────────────────────────────────────────────
# Seconds before a tool call times out.
TOOL_EXECUTION_TIMEOUT=30

# ── stdio connections ──────────────────────────────────────────────────────
# Allow connecting to local processes via stdio. DISABLED by default because
# it lets the UI launch arbitrary commands on the server host.
# Only enable in fully trusted / development environments.
STDIO_ENABLED=false
# Optional comma-separated allowlist of permitted command basenames.
# When empty, all commands are permitted (only applies when STDIO_ENABLED=true).
# STDIO_ALLOWED_COMMANDS=python,node,uvx
STDIO_ALLOWED_COMMANDS=

# ── SSRF protection ────────────────────────────────────────────────────────
# Block server URLs that resolve to private/loopback addresses.
# Set to false ONLY in isolated dev environments with no sensitive metadata services.
SSRF_PROTECTION=true

# ── Server port ────────────────────────────────────────────────────────────
PORT=5000
